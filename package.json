{
  "name": "shavethatcat",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "esbuild src/script.ts --bundle --outfile=public/script.js --target=es2022",
    "dev": "esbuild src/script.ts --bundle --outfile=public/script.js --target=es2022 --watch",
    "preview": "npm run build && npx wrangler pages dev ./public"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241230.0",
    "esbuild": "^0.24.2",
    "wrangler": "^3.99.0"
  }
}
